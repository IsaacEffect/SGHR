@model SGHR.Application.Dtos.PisoDto

@{
    ViewData["Title"] = "Eliminar Piso";
}

<h2>¿Está seguro de que desea eliminar este piso?</h2>

<div>
    <h4>Piso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Número Piso</dt>
        <dd class="col-sm-10">@Model.NumeroPiso</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>
    </dl>
</div>

<form asp-action="DeleteConfirmed" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
