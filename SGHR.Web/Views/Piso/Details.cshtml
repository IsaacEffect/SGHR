@model SGHR.Application.Dtos.PisoDto

@{
    ViewData["Title"] = "Detalles del Piso";
}

<h2>Detalles del Piso</h2>

<div>
    <h4>Piso</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Número de Piso</dt>
        <dd class="col-sm-10">@Model.NumeroPiso</dd>

        <dt class="col-sm-2">Descripción</dt>
        <dd class="col-sm-10">@Model.Descripcion</dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
